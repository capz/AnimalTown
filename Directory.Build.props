<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <DndBuildNative>false</DndBuildNative>
    <DolphinDotNetRoot>$(MSBuildThisFileDirectory)vendor/sdk</DolphinDotNetRoot>
  </PropertyGroup>
</Project>
